# Copy to .env and adjust credentials for your Postgres instance
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/debating
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEFAULT_MAX_TURNS=25
USE_MOCK_LLM=false

# LLM keys (used by sim_chat when meetings run)
OPENAI_API_KEY=
GOOGLE_API_KEY=
