# Copy to backend/.env and adjust for your environment.
#
# Quick start (local):
#   docker compose up -d postgres
#   cd backend && alembic upgrade head && uvicorn app.main:app --reload --port 8000
#   cd frontend && npm run dev   # http://localhost:5173 → proxies /api to :8000

# =============================================================================
# LOCAL DEVELOPMENT (active by default)
# =============================================================================
# Password fss@123 must be URL-encoded as fss%40123 in DATABASE_URL
DATABASE_URL=postgresql+psycopg://fss:fss%40123@localhost:5432/debating
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEFAULT_MAX_TURNS=25
USE_MOCK_LLM=false

# LLM keys (used by sim_chat when meetings run)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# =============================================================================
# CLOUD DEPLOY (Railway backend + Supabase Postgres + Vercel frontend)
# Uncomment these and comment the LOCAL DATABASE_URL above when deploying.
# =============================================================================
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
