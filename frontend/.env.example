# =============================================================================
# LOCAL DEVELOPMENT (active) — leave VITE_API_BASE_URL unset
# =============================================================================
# Vite dev server proxies /api → http://127.0.0.1:8000 (see vite.config.ts).
# Start stack:
#   docker compose up -d postgres
#   cd backend && uvicorn app.main:app --reload --port 8000
#   cd frontend && npm run dev

# VITE_API_BASE_URL=

# =============================================================================
# CLOUD / direct Railway API (Vercel or preview without vercel.json API rewrite)
# Uncomment when frontend must call Railway host directly (no Vite proxy).
# Also restore frontend/vercel.cloud.json → vercel.json for Vercel deploy.
# =============================================================================
# VITE_API_BASE_URL=https://debating-production.up.railway.app
